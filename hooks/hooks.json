{
  "hooks": {
    "PreToolUse": [{
      "matcher": "Agent|spawn_agent|apply_patch|Bash|exec_command|shell_command",
      "hooks": [{ "type": "command", "command": "python3 \"${CODEX_PLUGIN_ROOT}/skills/lemmings/scripts/run.py\" hook", "commandWindows": "py -3 \"${CODEX_PLUGIN_ROOT}\\skills\\lemmings\\scripts\\run.py\" hook" }]
    }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "python3 \"${CODEX_PLUGIN_ROOT}/skills/lemmings/scripts/run.py\" hook", "commandWindows": "py -3 \"${CODEX_PLUGIN_ROOT}\\skills\\lemmings\\scripts\\run.py\" hook" }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "python3 \"${CODEX_PLUGIN_ROOT}/skills/lemmings/scripts/run.py\" hook", "commandWindows": "py -3 \"${CODEX_PLUGIN_ROOT}\\skills\\lemmings\\scripts\\run.py\" hook" }] }]
  }
}
