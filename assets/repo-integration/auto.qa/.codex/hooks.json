{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/plugins/unigame-agent-orchestration/scripts/hook_handler.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; py -3 (Join-Path $root 'plugins/unigame-agent-orchestration/scripts/hook_handler.py')\""
          }
        ]
      },
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/plugins/unigame-agent-orchestration/scripts/hook_handler.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; py -3 (Join-Path $root 'plugins/unigame-agent-orchestration/scripts/hook_handler.py')\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/plugins/unigame-agent-orchestration/scripts/hook_handler.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; py -3 (Join-Path $root 'plugins/unigame-agent-orchestration/scripts/hook_handler.py')\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/plugins/unigame-agent-orchestration/scripts/hook_handler.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; py -3 (Join-Path $root 'plugins/unigame-agent-orchestration/scripts/hook_handler.py')\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/plugins/unigame-agent-orchestration/scripts/hook_handler.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; py -3 (Join-Path $root 'plugins/unigame-agent-orchestration/scripts/hook_handler.py')\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/plugins/unigame-agent-orchestration/scripts/hook_handler.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; py -3 (Join-Path $root 'plugins/unigame-agent-orchestration/scripts/hook_handler.py')\""
          }
        ]
      }
    ]
  }
}
