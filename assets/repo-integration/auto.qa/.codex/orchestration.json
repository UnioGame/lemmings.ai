{
  "schemaVersion": 1,
  "enabled": true,
  "plugin": { "name": "unigame-agent-orchestration", "scope": "workspace" },
  "taskAdapter": "autoqa-markdown-v1",
  "roadmap": "docs/tasks/ROADMAP.md",
  "taskGlobs": ["docs/tasks/**/*.md"],
  "handoffGlobs": ["docs/context/**/*handoff*.md", "docs/tasks/**/handoffs/*.md"],
  "reviewGlobs": ["docs/tasks/**/reviews/*.md"],
  "worktreeRoot": "../unigame.auto.qa.worktrees",
  "phaseBranchPattern": "codex/phase-{phase}-{slug}",
  "taskBranchPattern": "codex/{taskId}-{slug}",
  "maxAgents": 3,
  "maxWriters": 2,
  "integrationStrategy": "no-ff",
  "reviewCycles": 2,
  "candidateCommitRequired": true,
  "recursiveDelegation": false,
  "sharedContractOwner": "orchestrator",
  "models": {
    "orchestrator": { "model": "gpt-5.6-sol", "effort": "high" },
    "reviewer": { "model": "gpt-5.6-sol", "effort": "high" },
    "complex-worker": { "preferred": { "model": "gpt-5.5", "effort": "medium" }, "approvedFallback": { "model": "gpt-5.6-sol", "effort": "medium" } },
    "worker": { "preferred": { "model": "gpt-5.4", "effort": "medium" }, "approvedFallback": { "model": "gpt-5.6-terra", "effort": "medium" } }
  },
  "context": { "focusedExpansionLimit": 1, "excludedGlobs": ["**/node_modules/**", "**/bin/**", "**/obj/**", "**/artifacts/**", "**/runs/**", "**/*.apk", "**/*.mp4", "**/*.log"] },
  "hooks": { "policy": "hybrid", "continuationLimit": 1, "failClosed": ["spawn-safety", "write-scope"], "failOpen": ["handoff-quality", "validation-completeness"] }
}
