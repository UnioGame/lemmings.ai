{
  "schemaVersion": 5,
  "distributionVersion": "6.0.0",
  "mode": "auto",
  "roadmap": "docs/tasks/ROADMAP.md",
  "taskGlobs": [
    "docs/tasks/**/*.json"
  ],
  "reviewGlobs": [
    "docs/tasks/reviews/*.json"
  ],
  "worktreeRoot": "../lemmings-worktrees",
  "modelRoutes": {},
  "contextPolicy": {
    "maxPacketBytes": 16384,
    "maxWorkingSetItems": 12,
    "maxExpansions": 1,
    "ceilings": {
      "maxPacketBytes": 32768,
      "maxWorkingSetItems": 24,
      "maxExpansions": 3
    }
  },
  "orchestration": {
    "maxDelegationDepth": 1,
    "maxConcurrentWriters": 2,
    "maxConcurrentReaders": 2,
    "managerSlots": 1,
    "maxRepairs": 3,
    "maxTransportRetries": 1
  },
  "workspacePool": {
    "enabled": true,
    "maxIdle": 2,
    "maxIdleGiB": 10,
    "eviction": "lru"
  },
  "game": {
    "engine": "auto",
    "projectPath": ".",
    "workspace": {
      "policy": "auto",
      "parallelStrategy": "hybrid",
      "largeThresholdGiB": 10,
      "validationBackend": "clone",
      "validationPath": "../PROJECT.lemmings.validation"
    }
  },
  "invocationBudgets": {
    "explorer": {
      "initialToolCalls": 12,
      "maxToolCalls": 24
    },
    "reviewer": {
      "initialToolCalls": 16,
      "maxToolCalls": 32
    },
    "worker": {
      "initialToolCalls": 24,
      "maxToolCalls": 48
    }
  },
  "accountingMode": "invocation-v1",
  "invocationLimits": {
    "worker": 5,
    "reviewer": 7,
    "explorer": 5
  }
}
